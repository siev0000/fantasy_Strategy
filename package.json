{
  "name": "fantasy-strategy",
  "version": "0.1.0",
  "private": true,
  "description": "Fantasy Strategy prototype with room-based multiplayer.",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build:front && node server.js",
    "dev": "concurrently -n front,server \"npm run dev:front:watch\" \"node server.js\"",
    "dev:test-on": "concurrently -n front,server \"npm run dev:front:test-on\" \"node server.js\"",
    "dev:front": "vite --config frontend/vite.config.mjs",
    "dev:front:test-on": "vite --mode teston --config frontend/vite.config.mjs",
    "dev:front:watch": "vite build --mode watch --watch --logLevel warn --config frontend/vite.config.mjs",
    "build:front": "vite build --config frontend/vite.config.mjs",
    "build:front:test-on": "vite build --mode teston --config frontend/vite.config.mjs",
    "audit:data": "node scripts/audit-game-data-usage.mjs",
    "benchmark:render": "node scripts/benchmark-v39-render-layers.mjs",
    "check:local-session": "node scripts/check-v39-local-session.mjs",
    "check:friendly-skill-targeting": "node scripts/check-v39-friendly-skill-targeting.mjs",
    "check:field-settings-scroll": "node scripts/check-v39-field-settings-scroll.mjs",
    "check:room-lobby": "node scripts/check-v39-room-lobby.mjs",
    "check:play-mode-select": "node scripts/check-v39-play-mode-select.mjs",
    "check:multiplayer-start-flow": "node scripts/check-v39-multiplayer-start-flow.mjs",
    "preview:front": "vite preview --config frontend/vite.config.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fontsource/noto-color-emoji": "5.3.1",
    "@fontsource/noto-sans-symbols": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^6.4.1"
  }
}
