{
  "name": "fantasy-strategy",
  "version": "0.1.0",
  "private": true,
  "description": "Fantasy Strategy prototype with room-based multiplayer.",
  "type": "commonjs",
  "scripts": {
    "check:logistics-routes": "node scripts/check-v39-logistics-routes.mjs && node scripts/check-v39-logistics-stops.mjs",
    "check:cemetery": "node scripts/check-v39-cemetery.mjs",
    "check:corpse-storage": "node scripts/check-v39-corpse-storage.mjs",
    "check:character-storage": "node scripts/check-v39-character-storage.mjs",
    "check:facility-storage": "node scripts/check-v39-facility-storage.mjs",
    "check:fusion-layout": "node scripts/check-v39-fusion-layout.mjs",
    "check:fusion-artwork": "node scripts/check-v39-fusion-artwork.mjs",
    "check:soul-storage": "node scripts/check-v39-soul-storage.mjs",
    "check:boss-fusion": "node scripts/check-v39-boss-fusion.mjs",
    "check:enemy-formations": "node scripts/check-v39-enemy-formations.mjs",
    "check:fusion-test-materials": "node scripts/check-v39-fusion-test-materials.mjs",
    "check:unit-tab-retention": "node scripts/check-v39-unit-tab-retention.mjs",
    "check:monster-fusion-ui": "node scripts/check-v39-monster-fusion-ui.mjs",
    "start": "npm run build:front && node server.js",
    "dev": "concurrently -n front,server \"npm run dev:front:watch\" \"node server.js\"",
    "dev:test-on": "concurrently -n front,server \"npm run dev:front:test-on\" \"node server.js\"",
    "dev:front": "vite --config frontend/vite.config.mjs",
    "dev:front:test-on": "vite --mode teston --config frontend/vite.config.mjs",
    "dev:front:watch": "vite build --mode watch --watch --logLevel warn --config frontend/vite.config.mjs",
    "build:front": "vite build --config frontend/vite.config.mjs",
    "build:front:test-on": "vite build --mode teston --config frontend/vite.config.mjs",
    "audit:data": "node scripts/audit-game-data-usage.mjs",
    "check:event-dialogue": "node scripts/check-v39-event-dialogue.mjs",
    "check:village-sheet-dialogue": "node scripts/check-v39-village-sheet-dialogue.mjs",
    "check:ui-render-work": "node scripts/check-v39-ui-render-work.mjs",
    "check:game-ui-layout": "node scripts/check-v39-game-ui-layout.mjs",
    "check:squad-membership-ui": "node scripts/check-v39-squad-membership-ui.mjs",
    "check:squad-coordination": "node scripts/check-v39-squad-coordination.mjs",
    "check:trade-input-stability": "node scripts/check-v39-trade-input-stability.mjs",
    "check:summon-retained-ui": "node scripts/check-v39-summon-retained-ui.mjs",
    "check:research-flow-ui": "node scripts/check-v39-research-flow-ui.mjs",
    "check:research-discovery-ui": "node scripts/check-v39-research-discovery-ui.mjs",
    "check:research-efficiency-ui": "node scripts/check-v39-research-efficiency-ui.mjs",
    "check:monster-fusion-growth": "node scripts/check-v39-monster-fusion-growth.mjs",
    "check:map-snapshot-work": "node scripts/check-v39-map-snapshot-work.mjs",
    "check:turn-snapshot-safety": "node scripts/check-v39-turn-snapshot-safety.mjs",
    "check:effect-editor-lifecycle": "node scripts/check-v39-effect-editor-lifecycle.mjs",
    "check:event-sheet": "python -B -m unittest discover -s scripts -p test_event_sheet_converter.py -v",
    "benchmark:render": "node scripts/benchmark-v39-render-layers.mjs",
    "check:local-session": "node scripts/check-v39-local-session.mjs",
    "check:friendly-skill-targeting": "node scripts/check-v39-friendly-skill-targeting.mjs",
    "check:field-settings-scroll": "node scripts/check-v39-field-settings-scroll.mjs",
    "check:test-tools-scroll": "node scripts/check-v39-test-tools-scroll.mjs",
    "check:room-lobby": "node scripts/check-v39-room-lobby.mjs",
    "check:play-mode-select": "node scripts/check-v39-play-mode-select.mjs",
    "check:multiplayer-start-flow": "node scripts/check-v39-multiplayer-start-flow.mjs",
    "check:character-modal": "node scripts/check-v39-character-modal.mjs",
    "check:production-ui": "node scripts/check-v39-production-ui.mjs",
    "check:expedition-test": "node scripts/check-v39-expedition-test-fixture.mjs",
    "check:coordinate-ruler": "node scripts/check-v39-coordinate-ruler.mjs",
    "check:class-schema": "node scripts/check-v39-class-schema.mjs",
    "check:faction-ai-long-sim": "node scripts/check-v39-faction-ai-long-sim.mjs",
    "check:faction-ai-long-sim:100": "set V39_AI_SIM_TURNS=100&& node scripts/check-v39-faction-ai-long-sim.mjs",
    "check:neutral-village-sim": "node scripts/check-v39-neutral-village-sim.mjs",
    "check:neutral-village-sim:100": "set V39_VILLAGE_SIM_TURNS=100&& node scripts/check-v39-neutral-village-sim.mjs",
    "check:victory-landmark-placement": "node scripts/check-v39-victory-landmark-placement.mjs",
    "check:settlement-development": "node scripts/check-v39-settlement-development.mjs",
    "check:archipelago-size": "node scripts/check-v39-archipelago-island-size.mjs",
    "check:faction-ai-territory-assault": "node scripts/check-v39-faction-ai-territory-assault.mjs",
    "preview:front": "vite preview --config frontend/vite.config.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fontsource/noto-color-emoji": "5.3.1",
    "@fontsource/noto-sans-symbols": "5.3.0",
    "@fontsource/noto-sans-symbols-2": "5.3.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^6.4.1"
  }
}
